# ---- Postgres ----
POSTGRES_USER=btc_user
POSTGRES_PASSWORD=btc_password
POSTGRES_DB=btc_trading

# ---- Backend ----
DATABASE_URL=postgresql+asyncpg://btc_user:btc_password@postgres:5432/btc_trading
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change_me_to_a_long_random_string
ENVIRONMENT=development

# Market data source (public REST/WebSocket, read-only, no trading keys required)
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@kline_1m
BINANCE_REST_URL=https://api.binance.com

# If you later wire up real order execution, put exchange API keys in a secrets
# manager, NOT in this file. This project ships with trading DISABLED by default
# and paper-trading only (see Admin Panel "Enable/disable trading").
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# ---- Retraining ----
RETRAIN_CRON="0 3 * * 1"   # every Monday 03:00 UTC
MODEL_ARTIFACT_DIR=/app/artifacts

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
